{
  "private": true,
  "name": "grid-benchmark",
  "version": "0.1.0",
  "description": "Open benchmark suite comparing JavaScript data-grid performance",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "src/viewer"
  ],
  "scripts": {
    "data-server": "node src/data/server.js",
    "viewer": "vite src/viewer --port 5173 --open",
    "dev": "concurrently \"npm run data-server\" \"npm run viewer\"",
    "bench": "node bin/bench.js",
    "report": "node src/report/generate.js",
    "inspect": "node src/report/inspect.js",
    "vendor": "node scripts/vendor.js",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "playwright": "^1.49.0",
    "terser-webpack-plugin": "^5.6.1",
    "vite": "^5.4.0",
    "webpack": "^5.109.2"
  },
  "//dependencies": "The grids under test. Pinned exactly, never with a range: the whole point of the benchmark is that a published number names the build it measured, and a range re-resolves on every install. Bumping one is a deliberate commit, and `npm run vendor` records what it laid down in vendor/.versions.json.",
  "dependencies": {
    "@bryntum/grid-trial": "7.3.4",
    "@dhx/trial-grid": "9.3.8",
    "@progress/kendo-theme-default": "14.4.0",
    "@progress/kendo-ui": "2026.2.520",
    "ag-grid-community": "36.0.2",
    "devextreme": "26.1.3",
    "jquery": "4.0.0"
  }
}
